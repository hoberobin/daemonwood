{
  "name": "daemonwood",
  "version": "0.15.0-beta.1",
  "description": "Wake up a pixel workshop where every Claude Code session is a familiar. One command: npx daemonwood wake",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "agents",
    "pixel-art",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoberobin/daemonwood.git"
  },
  "homepage": "https://github.com/hoberobin/daemonwood#readme",
  "bugs": {
    "url": "https://github.com/hoberobin/daemonwood/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "daemonwood": "bin/daemonwood.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "start": "node bin/daemonwood.mjs",
    "test": "node --test tests/*.test.js",
    "art:export": "node scripts/export-art.mjs && node scripts/export-station-art.mjs",
    "art:check": "node scripts/check-art.mjs",
    "art:qa": "node scripts/art-qa.mjs",
    "connect": "node bin/daemonwood.mjs connect",
    "status": "node bin/daemonwood.mjs status",
    "disconnect": "node bin/daemonwood.mjs uninstall",
    "dev": "node server.mjs",
    "doctor": "node bin/daemonwood.mjs doctor",
    "repair": "node bin/daemonwood.mjs repair",
    "stop": "node bin/daemonwood.mjs stop",
    "uninstall:daemonwood": "node bin/daemonwood.mjs uninstall",
    "wake": "node bin/daemonwood.mjs wake",
    "sleep": "node bin/daemonwood.mjs sleep",
    "prepublishOnly": "node -e \"if(!process.env.DAEMONWOOD_RELEASE){console.error(\\\"Not released yet. When ready: DAEMONWOOD_RELEASE=1 npm publish (see docs/releasing.md).\\\");process.exit(1)}\" && npm test"
  },
  "files": [
    "bin/",
    "hooks/",
    "src/",
    "server.mjs",
    "index.html",
    "scripts/cli.mjs",
    "scripts/runtime.mjs",
    "scripts/local-files.mjs",
    "scripts/package-files.mjs",
    "scripts/daemon.mjs",
    "scripts/deliver.mjs",
    "scripts/claude-setup.mjs",
    "assets/map/",
    "assets/sprites/",
    "assets/palette/"
  ]
}
