{
  "name": "daemonwood",
  "version": "0.15.0-beta.1",
  "private": true,
  "description": "Watch local Claude Code sessions as pixel familiars in a Pacific Northwest workshop.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "daemonwood": "./bin/daemonwood.mjs"
  },
  "scripts": {
    "start": "node bin/daemonwood.mjs",
    "test": "node --test tests/*.test.js",
    "art:export": "node scripts/export-art.mjs && node scripts/export-station-art.mjs",
    "art:check": "node scripts/check-art.mjs",
    "art:qa": "node scripts/art-qa.mjs",
    "connect": "node bin/daemonwood.mjs connect",
    "status": "node bin/daemonwood.mjs status",
    "disconnect": "node bin/daemonwood.mjs uninstall",
    "dev": "node server.mjs",
    "doctor": "node bin/daemonwood.mjs doctor",
    "repair": "node bin/daemonwood.mjs repair",
    "stop": "node bin/daemonwood.mjs stop",
    "uninstall:daemonwood": "node bin/daemonwood.mjs uninstall"
  },
  "files": [
    "bin/",
    "hooks/",
    "src/",
    "server.mjs",
    "index.html",
    "scripts/cli.mjs",
    "scripts/runtime.mjs",
    "scripts/local-files.mjs",
    "scripts/package-files.mjs",
    "scripts/daemon.mjs",
    "scripts/deliver.mjs",
    "scripts/claude-setup.mjs",
    "assets/map/",
    "assets/sprites/",
    "assets/palette/"
  ]
}
